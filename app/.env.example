# Devnet wallet (JSON secret key array): mint authority of the test USDC, pays fees for test funds
# and payment collection. Never use a mainnet key here.
FAUCET_KEYPAIR=

# Random string (e.g. openssl rand -base64 48). Signs sign-in sessions and derives the scheduler token.
SESSION_SECRET=

# Telegram bot (from @BotFather) and a random webhook secret ([A-Za-z0-9_-], up to 256 chars).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Upstash Redis REST credentials (set automatically on Vercel by the Marketplace integration).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional. Defaults to the public devnet RPC.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
